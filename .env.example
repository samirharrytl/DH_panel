# Supabase (Project Settings > API Keys y Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) o, si usas las claves antiguas, la anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) o la service_role antigua. Solo servidor: nunca con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Cadena de conexión "Session pooler" (botón Connect del proyecto). Solo para aplicar migraciones
DATABASE_URL=

# URL pública del panel (en local, http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API (Meta). Con WHATSAPP_MODE=simulado no se llama a Meta
WHATSAPP_MODE=simulado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Versión de la Graph API (opcional)
WHATSAPP_GRAPH_VERSION=v23.0

# Protege /api/cron/* (Vercel lo envía como Bearer)
CRON_SECRET=

# Sitio web (landing en Astro) que usa /api/v1. Orígenes separados por comas, p. ej.
# https://depahostperu.com,http://localhost:4321
WEB_ORIGINS=
# Clave secreta de Cloudflare Turnstile del sitio. Sin ella no se verifica el captcha (solo en local)
TURNSTILE_SECRET_KEY=
